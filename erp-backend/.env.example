# Copy to .env (never commit .env). On Hostinger, set these in the server environment (or an .env file on the server) instead.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
# Random value, at least 32 characters, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
PORT=5001

# Security (all optional)
# Extra allowed browser origins, comma separated (added to https://skbw.in, https://www.skbw.in, https://api.skbw.in and localhost dev)
CORS_ORIGINS=
# Allow https://*.vercel.app preview deployments
ALLOW_VERCEL_PREVIEWS=false
# Number of reverse proxies in front of the app (set to 1 behind nginx / Hostinger's proxy so rate limits use the real client IP)
TRUST_PROXY=0
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_API_MAX=1000
